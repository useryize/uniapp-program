{
  "name": "uniapp-program",
  "version": "1.0.0",
  "description": "基于 uni-app、Vue 3 和 TypeScript 的多模块小程序，包含商城、壁纸、天气与音乐应用",
  "main": "main.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "vue-tsc --noEmit",
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build --platform h5",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=. uni --platform mp-weixin",
    "build:mp-weixin": "cross-env UNI_INPUT_DIR=. uni build --platform mp-weixin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useryize/uniapp-program.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/useryize/uniapp-program/issues"
  },
  "homepage": "https://github.com/useryize/uniapp-program#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-h5": "3.0.0-4060620250520001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "@types/node": "^22.20.5",
    "@vue/compiler-sfc": "^3.4.21",
    "cross-env": "^10.1.0",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vue-tsc": "^3.3.14"
  }
}
